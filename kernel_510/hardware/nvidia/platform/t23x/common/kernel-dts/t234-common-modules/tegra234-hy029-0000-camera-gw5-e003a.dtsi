/ {
		tegra-capture-vi {
			num-channels = <12>;
			/*num-channels = <8>;*/
			/*num-channels = <4>;*/
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
            #if 1
				port@0 {
					reg = <0>;
					gw5200_vi_in0: endpoint {
						devnode = "video1";
						vc-id = <0>;
						/*
						 * Port index is used to specify the connection between two different modules. 
						 * For the VI (video input) module, the port index represents the input stream. 
						 * For the CSI module, it represents the actual CSI port to which the camera is connected.
						 * see diagram for details.
						*/
						port-index = <0>;
						/* Number of CSI lanes connected to sensor; determines the bus width. */
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out0>;
					};
				};
				port@1 {
					reg = <1>;
					gw5200_vi_in1: endpoint {
						devnode = "video0";
						vc-id = <1>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out1>;
					};
				};
				port@2 {
					reg = <2>;
					gw5200_vi_in2: endpoint {
						devnode = "video3";
						vc-id = <2>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out2>;
					};
				};
				port@3 {
					reg = <3>;
					gw5200_vi_in3: endpoint {
						devnode = "video2";
						vc-id = <3>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out3>;
					};
				};
            #endif
            #if 1
				port@4 {
					reg = <4>;
					gw5200_vi_in4: endpoint {
						devnode = "video9";
						vc-id = <0>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out4>;
					};
				};
				port@5 {
					reg = <5>;
					gw5200_vi_in5: endpoint {
						devnode = "video8";
						vc-id = <1>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out5>;
					};
				};	
				port@6 {
					reg = <6>;
					gw5200_vi_in6: endpoint {
						devnode = "video11";
						vc-id = <2>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out6>;
					};
				};
				port@7 {
					reg = <7>;
					gw5200_vi_in7: endpoint {
						devnode = "video10";
						vc-id = <3>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out7>;
					};
				};
            #endif

            #if 1
				port@8 {
					reg = <8>;
					gw5200_vi_in8: endpoint {
						devnode = "video5";
						vc-id = <0>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out8>;
					};
				};
				port@9 {
					reg = <9>;
					gw5200_vi_in9: endpoint {
						devnode = "video4";
						vc-id = <1>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out9>;
					};
				};	
				port@a {
					reg = <0xa>;
					gw5200_vi_in10: endpoint {
						devnode = "video7";
						vc-id = <2>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out10>;
					};
				};
				port@b {
					reg = <0xb>;
					gw5200_vi_in11: endpoint {
						devnode = "video6";
						vc-id = <3>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5200_csi_out11>;
					};
				};
            #endif
			};
		};

	host1x@13e00000 {
		nvcsi@15a00000 {
			num-channels = <12>;
			/*num-channels = <8>;*/
			/*num-channels = <4>;*/
			#address-cells = <1>;
			#size-cells = <0>;
        #if 1
			channel@0 {
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in0: endpoint@0 {
						/*
						 * Port index is used to specify the connection between two different modules. 
						 * For the VI (video input) module, the port index represents the input stream. 
						 * For the CSI module, it represents the actual CSI port to which the camera is connected.
						 * see diagram for details.
						*/
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out0>;
						};
					};

					port@1 {
						reg = <1>;
						gw5200_csi_out0: endpoint@1 {
							remote-endpoint = <&gw5200_vi_in0>;
						};
					};

				};
			};
			channel@1 {
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in1: endpoint@2 {
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out1>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out1: endpoint@3 {
							remote-endpoint = <&gw5200_vi_in1>;
						};
					};
				};
			};
			channel@2 {
				reg = <2>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in2: endpoint@4 {
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out2>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out2: endpoint@5 {
							remote-endpoint = <&gw5200_vi_in2>;
						};
					};
				};
			};
			channel@3 {
				reg = <3>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in3: endpoint@6 {
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out3>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out3: endpoint@7 {
							remote-endpoint = <&gw5200_vi_in3>;
						};
					};
				};
			};
        #endif
        #if 1
			channel@4 {
				reg = <4>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in4: endpoint@8 {
							/*port-index = <6>;*/
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out4>;
						};
					};

					port@1 {
						reg = <1>;
						gw5200_csi_out4: endpoint@9 {
							remote-endpoint = <&gw5200_vi_in4>;
						};
					};

				};
			};
			channel@5 {
				reg = <5>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in5: endpoint@10 {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out5>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out5: endpoint@11 {
							remote-endpoint = <&gw5200_vi_in5>;
						};
					};
				};
			};
			channel@6 {
				reg = <6>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in6: endpoint@12 {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out6>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out6: endpoint@13 {
							remote-endpoint = <&gw5200_vi_in6>;
						};
					};
				};
			};
			channel@7 {
				reg = <7>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in7: endpoint@14 {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out7>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out7: endpoint@15 {
							remote-endpoint = <&gw5200_vi_in7>;
						};
					};
				};
			};
        #endif
        #if 1
			channel@8 {
				reg = <8>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in8: endpoint@16 {
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out8>;
						};
					};

					port@1 {
						reg = <1>;
						gw5200_csi_out8: endpoint@17 {
							remote-endpoint = <&gw5200_vi_in8>;
						};
					};

				};
			};
			channel@9 {
				reg = <9>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in9: endpoint@18 {
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out9>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out9: endpoint@19 {
							remote-endpoint = <&gw5200_vi_in9>;
						};
					};
				};
			};
			channel@a {
				reg = <0xa>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in10: endpoint@20 {
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out10>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out10: endpoint@21 {
							remote-endpoint = <&gw5200_vi_in10>;
						};
					};
				};
			};
			channel@b {
				reg = <0xb>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_csi_in11: endpoint@22 {
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_gw5200_out11>;
						};
					};
					port@1 {
						reg = <1>;
						gw5200_csi_out11: endpoint@23 {
							remote-endpoint = <&gw5200_vi_in11>;
						};
					};
				};
			};
        #endif
		};

	};

	i2c@3180000 {

			gw5200_a@1b {
				compatible = "nvidia,gw5200";
				reg = <0x1b>;
				physical_w = "15.0";
				physical_h = "12.5";
				//def-mode = <0>;
				sensor_model ="e003a";
				post_crop_frame_drop = "0";
				use_decibel_gain = "true";
				delayed_gain = "true";
				//use_sensor_mode_id = "true";
				mode0 {
					mclk_khz = "24000";
					num_lanes = "4";
					/* enable dphy */
					phy_mode = "DPHY";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					mode_type = "yuv";
					pixel_phase = "yuyv";
					csi_pixel_bit_depth = "16";
					active_w = "1920";
					active_h = "1080";
					//pixel_t = "yuv_yuyv16";
					readout_orientation = "0";
					line_length = "4400";
					inherent_gain = "1";
					pix_clk_hz = "148500000";
					serdes_pix_clk_hz = "300000000";
					gain_factor = "10";
					min_gain_val = "0"; /* dB */
					max_gain_val = "300"; /* dB */
					step_gain_val = "3"; /* 0.3 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "30000000";
					max_framerate = "30000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "59"; /*us, 2 lines*/
					max_exp_time = "33333";
					step_exp_time = "1";
					default_exp_time = "33333";/* us */
					embedded_metadata_height = "0";
				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_gw5200_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_csi_in0>;
							};
						};
					};
				gmsl-link {
					src-csi-port = "b";
					dst-csi-port = "b";
					serdes-csi-link = "a";
					csi-mode = "1x4";
					st-vc = <0>;
					vc-id = <0>;
					num-lanes = <4>;
					streams = "yuv422-8";
					};
				};
			gw5200_b@1c {
				compatible = "nvidia,gw5200";
				reg = <0x1c>;
				physical_w = "15.0";
				physical_h = "12.5";
				//def-mode = <0>;
				sensor_model ="e003a";
				post_crop_frame_drop = "0";
				use_decibel_gain = "true";
				delayed_gain = "true";
				//use_sensor_mode_id = "true";
				mode0 {
					mclk_khz = "24000";
					num_lanes = "4";
					phy_mode = "DPHY";
					tegra_sinterface = "serial_a";
					vc_id = "1";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					mode_type = "yuv";
					pixel_phase = "yuyv";
					csi_pixel_bit_depth = "16";
					active_w = "1920";
					active_h = "1080";
					//pixel_t = "yuv_yuyv16";
					readout_orientation = "0";
					line_length = "4400";
					inherent_gain = "1";
					pix_clk_hz = "148500000";
					serdes_pix_clk_hz = "300000000";
					gain_factor = "10";
					min_gain_val = "0"; /* dB */
					max_gain_val = "300"; /* dB */
					step_gain_val = "3"; /* 0.3 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "30000000";
					max_framerate = "30000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "59"; /*us, 2 lines*/
					max_exp_time = "33333";
					step_exp_time = "1";
					default_exp_time = "33333";/* us */
					embedded_metadata_height = "0";
				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_gw5200_out1: endpoint {
							vc-id = <1>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_csi_in1>;
							};
						};
					};
				gmsl-link {
					src-csi-port = "b";
					dst-csi-port = "b";
					serdes-csi-link = "b";
					csi-mode = "1x4";
					st-vc = <0>;
					vc-id = <1>;
					num-lanes = <4>;
					streams = "yuv422-8";
					};
				};

			gw5200_c@1d {
				compatible = "nvidia,gw5200";
				reg = <0x1d>;
				physical_w = "15.0";
				physical_h = "12.5";
				//def-mode = <0>;
				sensor_model ="e003a";
				post_crop_frame_drop = "0";
				use_decibel_gain = "true";
				delayed_gain = "true";
				//use_sensor_mode_id = "true";
				mode0 {
					mclk_khz = "24000";
					num_lanes = "4";
					phy_mode = "DPHY";
					tegra_sinterface = "serial_a";
					vc_id = "2";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					mode_type = "yuv";
					pixel_phase = "yuyv";
					csi_pixel_bit_depth = "16";
					active_w = "1920";
					active_h = "1080";
					//pixel_t = "yuv_yuyv16";
					readout_orientation = "0";
					line_length = "4400";
					inherent_gain = "1";
					pix_clk_hz = "148500000";
					serdes_pix_clk_hz = "300000000";
					gain_factor = "10";
					min_gain_val = "0"; /* dB */
					max_gain_val = "300"; /* dB */
					step_gain_val = "3"; /* 0.3 */
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "30000000";
					max_framerate = "30000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "59"; /*us, 2 lines*/
					max_exp_time = "33333";
					step_exp_time = "1";
					default_exp_time = "33333";/* us */
