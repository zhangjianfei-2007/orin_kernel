				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5200_gw5200_out2: endpoint {
							vc-id = <2>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5200_csi_in2>;
							};
						};
					};
				gmsl-link {
					src-csi-port = "b";
					dst-csi-port = "b";
					serdes-csi-link = "c";
					csi-mode = "1x4";
					st-vc = <0>;
					vc-id = <2>;
					num-lanes = <4>;
					streams = "yuv422-8";
					};
				};

			gw5200_d@1e{
				compatible = "nvidia,gw5200";
				reg = <0x1e>;
				physical_w = "15.0";
				physical_h = "12.5";
				//def-mode = <0>;
