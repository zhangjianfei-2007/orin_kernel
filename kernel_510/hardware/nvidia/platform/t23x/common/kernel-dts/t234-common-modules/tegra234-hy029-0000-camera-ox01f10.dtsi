/ {
		tegra-capture-vi {
			num-channels = <12>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
            #if 1
				port@0 {
					reg = <0>;
					ox01f10_vi_in0: endpoint {
						devnode = "video1";
						vc-id = <0>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out0>;
					};
				};
				port@1 {
					reg = <1>;
					ox01f10_vi_in1: endpoint {
						devnode = "video0";
						vc-id = <1>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out1>;
					};
				};
				port@2 {
					reg = <2>;
					ox01f10_vi_in2: endpoint {
						devnode = "video3";
						vc-id = <2>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out2>;
					};
				};
				port@3 {
					reg = <3>;
					ox01f10_vi_in3: endpoint {
						devnode = "video2";
						vc-id = <3>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out3>;
					};
				};
            #endif
            #if 1
				port@4 {
					reg = <4>;
					ox01f10_vi_in4: endpoint {
						devnode = "video9";
						vc-id = <0>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out4>;
					};
				};
				port@5 {
					reg = <5>;
					ox01f10_vi_in5: endpoint {
						devnode = "video8";
						vc-id = <1>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out5>;
					};
				};	
				port@6 {
					reg = <6>;
					ox01f10_vi_in6: endpoint {
						devnode = "video11";
						vc-id = <2>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out6>;
					};
				};
				port@7 {
					reg = <7>;
					ox01f10_vi_in7: endpoint {
						devnode = "video10";
						vc-id = <3>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out7>;
					};
				};
				port@8 {
					reg = <8>;
					ox01f10_vi_in8: endpoint {
						devnode = "video5";
						vc-id = <0>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out8>;
					};
				};
				port@9 {
					reg = <9>;
					ox01f10_vi_in9: endpoint {
						devnode = "video4";
						vc-id = <1>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out9>;
					};
				};
				port@a {
					reg = <0xa>;
					ox01f10_vi_in10: endpoint {
						devnode = "video7";
						vc-id = <2>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out10>;
					};
				};
				port@b {
					reg = <0xb>;
					ox01f10_vi_in11: endpoint {
						devnode = "video6";
						vc-id = <3>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&ox01f10_csi_out11>;
					};
				};
            #endif
			};
		};

	host1x@13e00000 {
		nvcsi@15a00000 {
			num-channels = <12>;
			#address-cells = <1>;
			#size-cells = <0>;
        #if 1
			channel@0 {
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
