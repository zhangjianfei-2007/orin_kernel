			module11 {
				badge = "ar0231_centerright";
				position = "camera_11";
				orientation = "0";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "ox01f10 7-001e";
					proc-device-tree = "/proc/device-tree/i2c@c250000/ox01f10_l@1e";
				};
			};
            #endif
		};
	};
};
