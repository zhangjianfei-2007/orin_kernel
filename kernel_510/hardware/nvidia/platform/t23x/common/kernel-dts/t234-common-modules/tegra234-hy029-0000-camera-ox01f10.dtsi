	i2c@3180000 {

			ox01f10_a@1b {
				compatible = "nvidia,ox01f10";
				reg = <0x1b>;
				physical_w = "15.0";
				physical_h = "12.5";
				sensor_model ="ox01f10";
				post_crop_frame_drop = "0";
				use_decibel_gain = "true";
				delayed_gain = "true";
				//use_sensor_mode_id = "true";
				mode0 {
					mclk_khz = "27000";
					num_lanes = "4";
					phy_mode = "DPHY";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					mode_type = "yuv";
					pixel_phase = "yuyv";
					csi_pixel_bit_depth = "16";
					active_w = "1280";
					active_h = "960";
					//pixel_t = "yuv_yuyv16";
					readout_orientation = "0";
					line_length = "4400";
					inherent_gain = "1";
					pix_clk_hz = "148500000";
					serdes_pix_clk_hz = "150000000";
					min_framerate = "30";
					max_framerate = "30";
				};
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						ox01f10_ox01f10_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&ox01f10_csi_in0>;
							};
						};
					};
				gmsl-link {
					src-csi-port = "b";
					dst-csi-port = "b";
					serdes-csi-link = "a";
					csi-mode = "1x4";
					st-vc = <0>;
					vc-id = <0>;
					num-lanes = <4>;
					streams = "yuv422-8";
					};
				};
			ox01f10_b@1c {
				compatible = "nvidia,ox01f10";
				reg = <0x1c>;
				physical_w = "15.0";
				physical_h = "12.5";
