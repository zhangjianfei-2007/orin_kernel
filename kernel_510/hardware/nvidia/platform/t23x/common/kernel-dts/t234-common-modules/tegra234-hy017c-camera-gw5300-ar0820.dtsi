/ {
		tegra-capture-vi {
			num-channels = <8>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
            #if 1
				port@0 {
					reg = <0>;
					gw5300_vi_in0: endpoint {
						vc-id = <0>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out0>;
					};
				};
				port@1 {
					reg = <1>;
					gw5300_vi_in1: endpoint {
						vc-id = <1>;
						port-index = <0>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out1>;
					};
				};
				port@2 {
					reg = <2>;
					gw5300_vi_in2: endpoint {
						vc-id = <0>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out2>;
					};
				};
				port@3 {
					reg = <3>;
					gw5300_vi_in3: endpoint {
						vc-id = <1>;
						port-index = <2>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out3>;
					};
				};
            #endif
            #if 1
				port@4 {
					reg = <4>;
					gw5300_vi_in4: endpoint {
						vc-id = <0>;
						port-index = <5>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out4>;
					};
				};
				port@5 {
					reg = <5>;
					gw5300_vi_in5: endpoint {
						vc-id = <1>;
						port-index = <5>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out5>;
					};
				};	
				port@6 {
					reg = <6>;
					gw5300_vi_in6: endpoint {
						vc-id = <0>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out6>;
					};
				};
				port@7 {
					reg = <7>;
					gw5300_vi_in7: endpoint {
						vc-id = <1>;
						port-index = <4>;
						bus-width = <4>;
						remote-endpoint = <&gw5300_csi_out7>;
					};
				};
            #endif
			};
		};

	host1x@13e00000 {
		nvcsi@15a00000 {
			num-channels = <8>;
			#address-cells = <1>;
			#size-cells = <0>;
        #if 1
			channel@0 {
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in0: endpoint@0 {
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out0>;
						};
					};

					port@1 {
						reg = <1>;
						gw5300_csi_out0: endpoint@1 {
							remote-endpoint = <&gw5300_vi_in0>;
						};
					};

				};
			};
			channel@1 {
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in1: endpoint@2 {
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out1>;
						};
					};
					port@1 {
						reg = <1>;
						gw5300_csi_out1: endpoint@3 {
							remote-endpoint = <&gw5300_vi_in1>;
						};
					};
				};
			};
			channel@2 {
				reg = <2>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in2: endpoint@4 {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out2>;
						};
					};
					port@1 {
						reg = <1>;
						gw5300_csi_out2: endpoint@5 {
							remote-endpoint = <&gw5300_vi_in2>;
						};
					};
				};
			};
			channel@3 {
				reg = <3>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in3: endpoint@6 {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out3>;
						};
					};
					port@1 {
						reg = <1>;
						gw5300_csi_out3: endpoint@7 {
							remote-endpoint = <&gw5300_vi_in3>;
						};
					};
				};
			};
        #endif
        #if 1
			channel@4 {
				reg = <4>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in4: endpoint@8 {
							port-index = <6>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out4>;
						};
					};

					port@1 {
						reg = <1>;
						gw5300_csi_out4: endpoint@9 {
							remote-endpoint = <&gw5300_vi_in4>;
						};
					};

				};
			};
			channel@5 {
				reg = <5>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in5: endpoint@10 {
							port-index = <6>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out5>;
