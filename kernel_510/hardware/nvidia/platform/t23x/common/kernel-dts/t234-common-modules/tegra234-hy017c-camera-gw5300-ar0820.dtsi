					};
					port@1 {
						reg = <1>;
						gw5300_csi_out5: endpoint@11 {
							remote-endpoint = <&gw5300_vi_in5>;
						};
					};
				};
			};
			channel@6 {
				reg = <6>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in6: endpoint@12 {
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&gw5300_gw5300_out6>;
						};
					};
					port@1 {
						reg = <1>;
						gw5300_csi_out6: endpoint@13 {
							remote-endpoint = <&gw5300_vi_in6>;
						};
					};
				};
			};
			channel@7 {
				reg = <7>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						gw5300_csi_in7: endpoint@14 {
							port-index = <4>;
							bus-width = <4>;
