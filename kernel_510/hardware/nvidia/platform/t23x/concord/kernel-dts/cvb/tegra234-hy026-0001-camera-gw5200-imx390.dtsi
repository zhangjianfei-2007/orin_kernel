#include <t234-common-modules/tegra234-hy026-0001-camera-gw5200-imx390.dtsi>
#include "dt-bindings/clock/tegra234-clock.h"

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

/* camera control gpio definitions */

/ {

	/* set camera gpio direction to output */
	gpio@2200000 {
		camera-control-output-low {
			gpio-hog;
			output-low;
			gpios = <CAM0_RST_L 0 CAM1_RST_L 0
				 CAM2_RST_L 0 CAM3_RST_L 0>;

			label = "cam0-rst", "cam1-rst",
				"cam2-rst", "cam3-rst";
		};
	};

	i2c@3180000 {
		clock-frequency = <400000>;
	
        CamPOC12V_a: max2008X@00{
            compatible = "HYZX,max20087";
            reg = <0x28>;
            out-ports = <4>;
            out-boot-on = <1 1 1 1>;
            power-on-delay = <250>;
            status = "okay";
        };
        CamPOC12V_b: max2008X@01{
            compatible = "HYZX,max20087";
            reg = <0x29>;
            out-ports = <4>;
            out-boot-on = <1 1 1 1>;
            power-on-delay = <250>;
            status = "okay";
        };

		/* max96712 A: 0x6b */
		dser_a: max96712_a@6b{
			compatible = "nvidia,max96712";
			reg = <0x6b>;
			/* two of the 2-trio PHYs are combined as 4-trio */
			csi-mode = "2x4";
			max-src = <4>;
			dser-num = <0>;
			mipi-clk = <600>;  /* mipi-clk: MHz */
			gmsl-mode = "gmsl-2";  /* Example: "gmsl-1", "gmsl-2", "gmsl-2-3G" */
			reset-gpios = <&tegra_main_gpio CAM0_RST_L GPIO_ACTIVE_HIGH>;
		};

		/* max96712 B: 0x2a */
		dser_b: max96712_b@2a{
			compatible = "nvidia,max96712";
			reg = <0x2a>;
			csi-mode = "2x4";
			max-src = <4>;
			dser-num = <1>;
			mipi-clk = <600>;  /* mipi-clk: MHz */
			gmsl-mode = "gmsl-2";  /* Example: "gmsl-1", "gmsl-2", "gmsl-2-3G" */
			reset-gpios = <&tegra_main_gpio CAM1_RST_L GPIO_ACTIVE_HIGH>;
		};

		ser_prim_a: max9295_prim@40 {
			compatible = "nvidia,max9295";
			reg = <0x40>;
			group=<0>;
			is-prim-ser;
		};
		ser_a: max9295_a@11 {
			compatible = "nvidia,max9295";
			reg = <0x11>;
			group=<0>;
			dser-num = <0>;
			nvidia,gmsl-dser-device = <&dser_a>;
		};
		ser_b: max9295_b@12 {
			compatible = "nvidia,max9295";
			reg = <0x12>;
			group=<0>;
			dser-num = <0>;
			nvidia,gmsl-dser-device = <&dser_a>;
		};
		ser_c: max9295_c@13 {
			compatible = "nvidia,max9295";
			reg = <0x13>;
			group=<0>;
			dser-num = <0>;
			nvidia,gmsl-dser-device = <&dser_a>;
		};
		ser_d: max9295_d@14 {
			compatible = "nvidia,max9295";
			reg = <0x14>;
			group=<0>;
			dser-num = <0>;
			nvidia,gmsl-dser-device = <&dser_a>;
		};
		gw5200_a@1b {
			def-addr = <0x6d>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,
					<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			dser-num = <0>;
			dser-type = "max96712";
			nvidia,gmsl-ser-device = <&ser_a>;
			nvidia,gmsl-dser-device = <&dser_a>;
			gmsl-link {
				//frame-sync-en;
			};
		};
		gw5200_b@1c {
			def-addr = <0x6d>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,
					<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			dser-num = <0>;
			dser-type = "max96712";
			nvidia,gmsl-ser-device = <&ser_b>;
			nvidia,gmsl-dser-device = <&dser_a>;
			gmsl-link {
				//frame-sync-en;
			};
		};
		gw5200_c@1d {
			def-addr = <0x6d>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,
					<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			dser-num = <0>;
			dser-type = "max96712";
			nvidia,gmsl-ser-device = <&ser_c>;
			nvidia,gmsl-dser-device = <&dser_a>;
			gmsl-link {
				//frame-sync-en;
			};
		};
		gw5200_d@1e {
			def-addr = <0x6d>;
			clocks = <&bpmp_clks TEGRA234_CLK_EXTPERIPH1>,
					<&bpmp_clks TEGRA234_CLK_EXTPERIPH1>;
			clock-names = "extperiph1", "pllp_grtba";
			mclk = "extperiph1";
			dser-num = <0>;
			dser-type = "max96712";
			nvidia,gmsl-ser-device = <&ser_d>;
			nvidia,gmsl-dser-device = <&dser_a>;
			gmsl-link {
				//frame-sync-en;
			};
		};
	};

};
